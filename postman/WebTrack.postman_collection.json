							"name": "Login",
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test(\"Login exitoso y token guardado\", function () {\r",
											"    pm.response.to.have.status(200); // Verifica que el estado sea 200\r",
											"    var jsonData = pm.response.json(); // Obtiene la respuesta como JSON\r",
											"    if (jsonData.accessToken) {\r",
											"        pm.collectionVariables.set(\"token\", jsonData.accessToken); // Guarda el token en la variable de entorno\r",
											"        console.log(\"Token guardado: \" + jsonData.accessToken); // Muestra el token en la consola\r",
											"    } else {\r",
											"        console.error(\"No se encontró el token en la respuesta.\");\r",
											"    }\r",
											"});"
										],
										"type": "text/javascript",
										"packages": {}
									}
								}
							],
